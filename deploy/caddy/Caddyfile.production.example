# Production example — copy over Caddyfile when you have a domain:
#   cp Caddyfile.production.example Caddyfile
#
# Set in .env (repository root):
#   CADDY_EMAIL=you@example.com
#   DEVITRI_DOMAIN=devitri.example.com
#   DEVITRI_CORS_ORIGINS=https://devitri.example.com
#   DEVITRI_TRUST_PROXY_HEADERS=true
#
# Rebuild frontend if API and dashboard share this host (same-origin build is OK):
#   docker compose -f deploy/caddy/docker-compose.yml up -d --build

{
	email {$CADDY_EMAIL}
}

{$DEVITRI_DOMAIN} {
	handle /api/* {
		reverse_proxy backend:8080
	}
	handle /health {
		reverse_proxy backend:8080
	}
	handle {
		reverse_proxy frontend:80
	}
}
