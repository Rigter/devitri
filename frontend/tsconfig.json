{
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "es2020",
    "moduleResolution": "node"
  },
  "include": ["src/**/*.svelte", "src/**/*.ts", "src/**/*.js", "src/**/*.svelte.ts"],
  "exclude": ["node_modules"]
}
