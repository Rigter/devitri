# Frontend environment (copy to frontend/.env.local for local overrides)
#
# Required when the dashboard runs on your machine but the API is remote (profile A).
# Use the public HTTPS base URL of your Devitri API (no trailing slash).
#
# VITE_DEVITRI_BACKEND_URL=https://api.example.com
#
# When unset:
# - hostname localhost → http://localhost:8080 (local API)
# - otherwise → same origin as the dashboard (API + front served together)
