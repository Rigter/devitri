# =============================================================================
# Devitri — environment variables (copy to .env and adjust)
# =============================================================================
# Never commit .env with real secrets. First-run onboarding can generate
# DEVITRI_MASTER_HASH and DEVITRI_JWT_SECRET via /api/setup (see README).
# =============================================================================

# -----------------------------------------------------------------------------
# Required (after first-run / setup)
# -----------------------------------------------------------------------------
DEVITRI_MASTER_HASH=$2a$14$BcryptHash...
DEVITRI_JWT_SECRET=a1b2c3d4e5f6...

# -----------------------------------------------------------------------------
# Deployment profiles — DEVITRI_CORS_ORIGINS
# -----------------------------------------------------------------------------
# CORS applies to the web dashboard in the browser only (not the Obsidian plugin).
# Use exact origins (scheme + host + port), comma-separated, no spaces unless quoted.
#
# A) API public, dashboard on your machine (recommended for personal use)
#    Expose only the backend with HTTPS. Run the frontend locally (Vite/preview).
#    DEVITRI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
#    Frontend: set VITE_DEVITRI_BACKEND_URL=https://api.example.com (see frontend/.env.example)
#
# B) API + dashboard both public (same or different hostnames)
#    DEVITRI_CORS_ORIGINS=https://devitri.example.com
#    If dashboard and API are on different subdomains, list both origins:
#    DEVITRI_CORS_ORIGINS=https://app.example.com,https://api.example.com
#
# C) Local Docker stack (deploy/dev/docker-compose.yml — frontend on :3000)
#    DEVITRI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
#
# Default when unset: http://localhost:3000 and :5173 / :4173 (Vite dev + preview).
# Production: always set DEVITRI_CORS_ORIGINS explicitly; never rely on defaults.
#
# DEVITRI_CORS_ORIGINS=https://devitri.example.com

# Behind Traefik/Caddy: trust X-Forwarded-For / X-Real-IP only if the proxy is yours
# DEVITRI_TRUST_PROXY_HEADERS=true

# -----------------------------------------------------------------------------
# External Traefik (deploy/traefik-external/docker-compose.yml)
# -----------------------------------------------------------------------------
# Hostnames only (no https://) — used in Traefik Host() rules:
# DEVITRI_API_HOST=api.example.com
# DEVITRI_WEB_HOST=devitri.example.com
#
# Full public API URL — baked into frontend at docker build time:
# DEVITRI_BACKEND_URL=https://api.example.com
#
# Optional Traefik wiring (defaults: network traefik, entrypoint websecure, resolver letsencrypt):
# DEVITRI_TRAEFIK_NETWORK=traefik
# DEVITRI_TRAEFIK_ENTRYPOINT=websecure
# DEVITRI_TRAEFIK_CERT_RESOLVER=letsencrypt
#
# Optional paths inside the backend container (defaults: /data, /vaults):
# DEVITRI_DATA_DIR=/data
# DEVITRI_VAULTS_DIR=/vaults

# -----------------------------------------------------------------------------
# Local development only
# -----------------------------------------------------------------------------
# Allows a fixed dev JWT secret when DEVITRI_JWT_SECRET is unset (never in production)
# DEVITRI_ALLOW_INSECURE_JWT=true

# -----------------------------------------------------------------------------
# Security — sessions and auth (optional)
# -----------------------------------------------------------------------------
DEVITRI_SESSION_TTL_HOURS=24
DEVITRI_DEVICE_TOKEN_TTL_DAYS=365
DEVITRI_LOGIN_RATE_LIMIT=5
DEVITRI_MAX_UPLOAD_BYTES=52428800

# -----------------------------------------------------------------------------
# Sync — bulk delete protection (optional)
# -----------------------------------------------------------------------------
DEVITRI_DELETE_THRESHOLD_COUNT=20
DEVITRI_DELETE_THRESHOLD_PERCENT=5

# -----------------------------------------------------------------------------
# Operational (optional)
# -----------------------------------------------------------------------------
DEVITRI_TZ=America/Mexico_City
DEVITRI_PUID=1000
DEVITRI_PGID=1000
